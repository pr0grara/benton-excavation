    "SITE_SLUG": "benton-excavation",
    "COMPANY": "Bentonville Excavation",
    "ALERT_TO": "azbaghda@gmail.com",
    "ALERT_FROM": "Bentonville Excavation <onboarding@resend.dev>"
  }
}
